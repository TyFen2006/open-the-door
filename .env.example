# Copy this file to `.env` for LOCAL testing with `netlify dev` only.
# In production you set these in Netlify → Site configuration → Environment variables.
# NEVER commit your real .env — it's gitignored.

# Required: your OpenAI secret key (starts with sk-...)
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (safe to leave unset):
# REALTIME_MODEL=gpt-4o-mini-realtime-preview
# FEEDBACK_MODEL=gpt-4o-mini
